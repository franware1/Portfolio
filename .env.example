# Where contact-form messages are delivered
EMAIL_TO=you@gmail.com

# Option A (production on Railway Free/Hobby): Resend HTTPS API.
# If RESEND_API_KEY is set, Resend is used and the Gmail vars below are ignored.
# Without a verified domain, keep the default sender and set EMAIL_TO to your Resend account email.
RESEND_API_KEY=
# RESEND_FROM=Portfolio Contact <contact@yourdomain.com>

# Option B (local dev / Railway Pro): Gmail SMTP with an App Password
EMAIL_USER=you@gmail.com
EMAIL_PASS=your_gmail_app_password

PORT=3001
# CORS_ORIGIN=http://localhost:5173
